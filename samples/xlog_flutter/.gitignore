# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
build/

# Override root .gitignore: prebuilt native binaries must be committed
# for plugin distribution.
!windows/libs/*.dll
!windows/libs/*.lib
!windows/libs/*.pdb

# Override root .gitignore: Flutter example Xcode projects are source files,
# not build artifacts. The root rule "*.xcodeproj" would otherwise exclude them.
!example/ios/Runner.xcodeproj/
!example/macos/Runner.xcodeproj/

# macos/Classes and ios/Classes contain ObjC files copied from darwin/Classes
# by `prepare_command` in the podspec. Only darwin/Classes is the source of truth.
# Platform-specific .c files (xlog_flutter.c, xlog_symbols.c) are NOT ignored.
macos/Classes/XLog*.h
macos/Classes/XLog*.m
ios/Classes/XLog*.h
ios/Classes/XLog*.m
